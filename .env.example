# Defaults baked into the build. On the device they can be changed in the
# settings screen (5 taps on the top-left corner).

# Location used for weather data (default: Hernandarias, Paraguay)
EXPO_PUBLIC_CITY=Hernandarias
EXPO_PUBLIC_LAT=-25.41
EXPO_PUBLIC_LON=-54.63

# Optional: JSON endpoint with agenda events and reminders
# (format: docs/agenda.example.json). Must allow CORS on web, e.g. a GitHub Gist raw URL.
EXPO_PUBLIC_AGENDA_URL=

# Web only: JSON endpoint returning an array of photo URLs for the slideshow.
# Default: /photos/index.json, generated from public/photos by `npm run build:web`.
EXPO_PUBLIC_PHOTOS_URL=

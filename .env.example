# Location used for weather data (default: Hernandarias, Paraguay)
NEXT_PUBLIC_LAT=-25.41
NEXT_PUBLIC_LON=-54.63
NEXT_PUBLIC_CITY=Hernandarias

# Optional: JSON endpoint returning an array of photo URLs for the slideshow.
# When empty, photos from /public/photos are used.
NEXT_PUBLIC_PHOTOS_URL=

# Optional: JSON endpoint with agenda events and reminders
# (format: docs/agenda.example.json). Must allow CORS, e.g. a GitHub Gist raw URL.
NEXT_PUBLIC_AGENDA_URL=

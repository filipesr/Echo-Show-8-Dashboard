{
  "expo": {
    "name": "Echo Dashboard",
    "slug": "echo-dashboard",
    "version": "0.1.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "echodashboard",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080c14",
    "android": {
      "package": "com.filipesr.echodashboard",
      "adaptiveIcon": {
        "backgroundColor": "#0e131e",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "HOME",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080c14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-brightness"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
